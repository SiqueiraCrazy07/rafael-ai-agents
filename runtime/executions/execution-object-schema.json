{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafael-ai-agents.local/runtime/execution-object-schema.json",
  "title": "Runtime Execution Object",
  "type": "object",
  "required": [
    "executionId",
    "workflow",
    "project",
    "agents",
    "status",
    "startedAt",
    "retries",
    "logs",
    "checkpoints",
    "decisions",
    "outputs",
    "risks"
  ],
  "properties": {
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "routed",
        "running",
        "waiting_input",
        "blocked",
        "retrying",
        "validated",
        "completed",
        "failed",
        "rolled_back"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "retries": {
      "type": "object",
      "required": ["count", "max"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "level", "event", "message"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "level": {
            "type": "string",
            "enum": ["debug", "info", "warn", "error"]
          },
          "event": {
            "type": "string"
          },
          "agent": {
            "type": ["string", "null"]
          },
          "message": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpointId", "createdAt", "status", "summary"],
        "properties": {
          "checkpointId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decisionId", "summary"],
        "properties": {
          "decisionId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "path": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "path"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "description"],
        "properties": {
          "level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "description": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    }
  }
}
